        {
          "step": 1,
          "action": "Client connects",
          "expected": "Transport connected"
        },
        {
          "step": 2,
          "action": "Send LCOMMAND_CLIENT_START",
          "expected": "Receive SCOMMAND_CLIENT_START_REPLY"
        },
        {
          "step": 3,
          "action": "Send LCOMMAND_PING",
          "expected": "Receive SCOMMAND_PING_RESPONSE"
        },
        {
          "step": 4,
          "action": "Send LCOMMAND_CLIENT_END",
          "expected": "Connection closed"
        }
      ],
      "cleanup": "None"
    },
