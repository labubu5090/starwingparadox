# Starwing Paradox - Single Cabinet Test Profile
# Copy to .env and customize

# Database
TEST_DATABASE_URL=postgresql+psycopg://starwing_test_user:CHANGE_ME@localhost:5432/starwing_test

# Server
HOST=127.0.0.1
PORT=4001
LEGACY_COMPATIBILITY_MODE=false

# TCP
PB_PORT=6666
PB_ENABLED=false
PB_TIMEOUT=30.0

# Capture
CAPTURE_ENABLED=false
CAPTURE_DIR=./captures

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=human

# Security
TRUSTED_HOSTS=127.0.0.1,localhost