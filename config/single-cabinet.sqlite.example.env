# Starwing Paradox Server - Single Cabinet SQLite Configuration
# Copy this file to .env and update as needed

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4001
PB_PORT=6666

# Database (SQLite only)
DATABASE_URL=sqlite+aiosqlite:///./data/starwing.db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Protocol
PB_TIMEOUT=30.0
PROTOCOL_RAW_LOGGING=false
PROTOCOL_HASH_LOGGING=true

# Legacy compatibility
LEGACY_COMPATIBILITY_MODE=true

# Server
MATCHER_HOSTNAME=paradox.yourdomain.com
VERSION_MAIN=70571
VERSION_DATA=70571

# Logging
LOG_LEVEL=INFO
