# Starwing Paradox - Phase 2A Single Cabinet Configuration
# Copy this file to .env and update as needed

# === Network ===
APP_HOST=0.0.0.0
APP_PORT=4001
PB_HOST=0.0.0.0
PB_PORT=6666

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/starwing.db

# === Logging ===
LOG_LEVEL=INFO
APP_ENV=development

# === Capture ===
CAPTURE_ENABLED=false
CAPTURE_RAW_ENABLED=false
CAPTURE_DIR=./data/captures
CAPTURE_REDACT_IDENTIFIERS=true

# === Limits ===
MAX_HTTP_BODY_SIZE=1048576
MAX_TCP_FRAME_SIZE=1048576
HTTP_REQUEST_TIMEOUT=30.0
TCP_IDLE_TIMEOUT=30.0

# === Feature Guards ===
MATCHER_ENABLED=false
BATTLE_ENABLED=false

# === Debug ===
DEBUG_DOCUMENTATION=false
PROTOCOL_RAW_LOGGING=false
PROTOCOL_HASH_LOGGING=true
LEGACY_COMPATIBILITY_MODE=true

# === Server Identity ===
MATCHER_HOSTNAME=paradox.yourdomain.com
VERSION_MAIN=70571
VERSION_DATA=70571
PB_TIMEOUT=30.0
