# Game Runtime Configuration
# Phase 2A-G3: Corrected port alignment

# HTTP Server (game server endpoint)
HTTP_HOST=127.0.0.1
HTTP_PORT=4001

# TCP Server (NesysService communication)
TCP_HOST=127.0.0.1
TCP_PORT=6666

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/starwing.db

# Capture (disabled by default)
CAPTURE_ENABLED=false

# Matching (guarded)
MATCHING_ENABLED=false

# Battle (guarded)
BATTLE_ENABLED=false

# Debug documentation
DOCS_ENABLED=false

# Identifier redaction
REDACT_IDENTIFIERS=true

# Legacy compatibility
LEGACY_COMPATIBILITY_MODE=true

# Protocol logging
PROTOCOL_RAW_LOGGING=false
PROTOCOL_HASH_LOGGING=true

# Game versions
VERSION_MAIN=70571
VERSION_DATA=70571
