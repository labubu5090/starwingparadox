{
  "security_boundary": {
    "in_scope": [
      "Local profile creation, selection, deletion",
      "Tutorial attempt tracking (local only)",
      "Session management (local only)",
      "Server status monitoring (loopback only)"
    ],
    "out_of_scope": [
      "NESYS authentication",
      "NESiCA identity",
      "Certificate verification",
      "Production matching",
      "Production entitlement",
      "Payment systems",
      "External network interfaces",
      "Game binary modification",
      "Game save file modification",
      "IsOnline or bNesysServerLive mutation",
      "Pipe emulation (port 1042)"
    ],
    "verification": {
      "game_binary_modified": false,
      "game_save_created_or_modified": false,
      "nesys_nesica_identity_field": false,
      "certificate_or_entitlement_field": false,
      "isonline_bnesysserverlive_mutation": false,
      "external_endpoint": false,
      "pipe_or_port1042_implementation": false,
      "local_profiles_private_server_only": true,
      "tutorial_completion_not_fabricated": true
    }
  }
}
